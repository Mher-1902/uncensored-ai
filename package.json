{
  "name": "offscript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:seo": "python3 scripts/check_seo.py",
    "test": "python3 -m unittest discover -s tests -p test_*.py && node --test tests/*.test.mjs",
    "start": "node server/index.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "fedora:inspect": "python3 self-host/readiness.py",
    "fedora:prepare": "python3 self-host/prepare.py",
    "fedora:model": "python3 self-host/run_model.py"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@gradio/client": "2.7.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
