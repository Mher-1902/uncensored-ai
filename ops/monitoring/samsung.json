{
  "uid": "offscript-samsung",
  "title": "Offscript \u00b7 Samsung",
  "tags": [
    "offscript",
    "private"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "20s",
  "time": {
    "from": "now-1h",
    "to": "now"
