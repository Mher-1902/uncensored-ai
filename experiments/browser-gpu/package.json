{
  "name": "offscript-browser-gpu-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort"
  },
  "dependencies": { "@wllama/wllama": "3.8.1" },
  "devDependencies": { "@types/node": "24.19.0", "typescript": "5.9.3", "vite": "7.3.7" }
}
