[Unit]
Description=Offscript ephemeral web gateway
After=network.target offscript-model.service

[Service]
Type=simple
WorkingDirectory=%h/uncensored-ai
ExecStart=/usr/bin/node server/index.mjs
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=PUBLIC_ORIGIN=https://offscript-ephemeral.sukiasyanmher7.chatgpt.site
Restart=on-failure
RestartSec=10
MemoryMax=256M
MemorySwapMax=0
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
